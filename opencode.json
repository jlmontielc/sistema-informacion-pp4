{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "enabled": true,
      "headers": {
        "X-Goog-Api-Key": "{env:STITCH_API_KEY}"
      }
    }
  },
  "permission": {
    "bash": {
      "docker-compose *": "allow",
      "docker *": "allow",
      "npm *": "allow",
      "python *": "allow",
      "gunicorn *": "allow",
      "git *": "ask",
      "*": "ask"
    }
  }
}